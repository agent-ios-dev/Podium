--- !tapi-tbd
tbd-version: 4
targets: [ armv7-ios ]
install-name: '/usr/lib/libSystem.B.dylib'
current-version: 173.8
exports:
  - targets: [ armv7-ios ]
    symbols: [ _socket, _ioctl, _connect, _getsockopt, _close, _read, _write, _fcntl, _usleep, _strlen, _strcpy, _memset, _memcpy, _inet_pton, _fopen, _fputs, _fclose, _access, _fork, _execl, __exit, _waitpid, dyld_stub_binder ]
...
